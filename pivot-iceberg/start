#!/bin/bash
# Starts the storage and the catalog (if they are not running), then Pivot.
set -e
source ./env.sh
../lib/iceberg/start

../lib/iceberg/substitute < config.yaml > config.generated.yaml
setsid nohup ./pivot server --config config.generated.yaml > server.log 2>&1 < /dev/null &
echo $! > server.pid
